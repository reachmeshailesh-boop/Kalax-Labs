# Provider: "mock" (deterministic, no key needed) or "gemini"
EXTRACT_PROVIDER=mock

# Required only when EXTRACT_PROVIDER=gemini. Server-side only; never commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

PORT=3010
HOST=127.0.0.1

# Public demo guardrails
EXTRACT_RATE_LIMIT=10
EXTRACT_RATE_WINDOW_MS=3600000
EXTRACT_MAX_IMAGE_BYTES=4194304
EXTRACT_TIMEOUT_MS=30000

# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For.
EXTRACT_TRUST_PROXY=0

# Destination of the "Build this for my organisation" button.
EXTRACT_CTA_URL=
